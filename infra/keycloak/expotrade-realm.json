        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8100/*"
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "email": "demo@expotrade.local",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
